{
  "manifest_version": 3,
  "name": "Staple",
  "version": "1.1.0",
  "description": "Staple a week of Substack essays into one PDF, EPUB or HTML file — free posts, plus paid ones you already subscribe to.",
  "homepage_url": "https://victorshammas.com/staple/",
  "minimum_chrome_version": "131",
  "action": {
    "default_title": "Open Staple",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.substack.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
